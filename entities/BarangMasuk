{
  "name": "BarangMasuk",
  "type": "object",
  "properties": {
    "nomor_referensi": {
      "type": "string",
      "description": "Nomor referensi/DO/invoice"
    },
    "tanggal": {
      "type": "string",
      "format": "date",
      "description": "Tanggal barang masuk"
    },
    "supplier": {
      "type": "string",
      "description": "Nama supplier"
    },
    "ekspedisi": {
      "type": "string",
      "description": "Nama ekspedisi / jasa pengiriman"
    },
    "ongkir": {
      "type": "number",
      "description": "Biaya ongkos kirim"
    },
    "ongkir_dibayar_oleh": {
      "type": "string",
      "description": "Siapa yang membayar ongkir (supplier/perusahaan)",
      "enum": [
        "Supplier",
        "Perusahaan",
        "Split"
      ]
    },
    "pic": {
      "type": "string",
      "description": "Penanggung jawab (PIC) - nama dari TeamMember"
    },
    "catatan": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "items": {
      "type": "array",
      "description": "Daftar item yang masuk",
      "items": {
        "type": "object",
        "properties": {
          "inventory_item_id": {
            "type": "string"
          },
          "nama_barang": {
            "type": "string"
          },
          "kategori": {
            "type": "string"
          },
          "satuan": {
            "type": "string"
          },
          "jumlah": {
            "type": "number"
          },
          "vendor": {
            "type": "string"
          },
          "keterangan": {
            "type": "string"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "confirmed"
      ],
      "default": "confirmed"
    },
    "input_by": {
      "type": "string",
      "description": "Email yang menginput"
    }
  },
  "required": [
    "tanggal",
    "items"
  ]
}