{
  "name": "RacikanDatabase",
  "type": "object",
  "properties": {
    "nama_brand": {
      "type": "string",
      "description": "Nama brand"
    },
    "nama_varian": {
      "type": "string",
      "description": "Nama varian / produk"
    },
    "ukuran_ml": {
      "type": "number",
      "description": "Ukuran botol dalam ml"
    },
    "racikan": {
      "type": "array",
      "description": "Daftar bahan dalam racikan final",
      "items": {
        "type": "object",
        "properties": {
          "kategori_bahan": {
            "type": "string",
            "description": "Bibit, Alkohol, Aqua Des, DPG, IPM, Lainnya"
          },
          "vendor": {
            "type": "string",
            "description": "Nama vendor (khusus bibit)"
          },
          "nama_bahan": {
            "type": "string"
          },
          "persentase": {
            "type": "number"
          },
          "volume_ml": {
            "type": "number",
            "description": "Volume dalam ml (dihitung otomatis)"
          }
        }
      }
    },
    "catatan": {
      "type": "string",
      "description": "Catatan tambahan"
    },
    "status": {
      "type": "string",
      "enum": [
        "aktif",
        "arsip"
      ],
      "default": "aktif"
    }
  },
  "required": [
    "nama_brand",
    "nama_varian"
  ]
}