{
  "name": "RiwayatProduksi",
  "type": "object",
  "properties": {
    "nama_brand": { "type": "string", "description": "Nama brand" },
    "tanggal": { "type": "string", "format": "date", "description": "Tanggal produksi" },
    "status_bayar": { "type": "string", "enum": ["Belum Bayar", "Sudah Bayar"], "default": "Belum Bayar" },
    "total_hpp_semua": { "type": "number", "description": "Total HPP semua produk" },
    "products": {
      "type": "array",
      "description": "Daftar produk dalam batch produksi ini",
      "items": {
        "type": "object",
        "properties": {
          "nama_product": { "type": "string" },
          "nama_brand": { "type": "string" },
          "qty": { "type": "number" },
          "botol_id": { "type": "string" },
          "botol_nama": { "type": "string" },
          "botol_ukuran_label": { "type": "number" },
          "botol_ukuran_aktual": { "type": "number" },
          "ukuran_digunakan": { "type": "string", "enum": ["label", "aktual"] },
          "tutup_id": { "type": "string" },
          "tutup_nama": { "type": "string" },
          "tutup_harga": { "type": "number" },
          "spray_id": { "type": "string" },
          "spray_nama": { "type": "string" },
          "spray_harga": { "type": "number" },
          "racikan": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bahan_id": { "type": "string" },
                "bahan_nama": { "type": "string" },
                "vendor": { "type": "string" },
                "kategori": { "type": "string" },
                "persentase": { "type": "number" },
                "volume_ml": { "type": "number" },
                "harga_per_satuan": { "type": "number" },
                "satuan": { "type": "string" },
                "hpp_bahan": { "type": "number" }
              }
            }
          },
          "hpp_per_pcs_label": { "type": "number" },
          "hpp_per_pcs_aktual": { "type": "number" },
          "hpp_per_pcs_digunakan": { "type": "number" },
          "total_hpp_product": { "type": "number" },
          "catatan": { "type": "string" }
        }
      }
    },
    "catatan_global": { "type": "string" }
  },
  "required": ["nama_brand", "tanggal"]
}